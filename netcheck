# --- ANSI colors ---
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[91m"
YELLOW = "\033[93m"
GREEN = "\033[92m"
CYAN = "\033[96m"
GRAY = "\033[90m"
BG_RED = "\033[41m"
BG_GREEN = "\033[42m"
SPARKLINE_CHARS = "▁▂▃▄▅▆▇█"
USE_COLOR = True


def ansi(s):
    return s if USE_COLOR else ""


def strip_ansi(s):
    return re.sub(r"\033\[[0-9;]*m", "", s)


def color_val(val, good, warn, unit="", inverse=False, fmt=".0f"):
    """Color a value green/yellow/red based on thresholds."""
    if val is None:
        return f"{ansi(RED)}{'--':>6}{unit}{ansi(RESET)}"
    if inverse:
        c = GREEN if val >= good else (YELLOW if val >= warn else RED)
    else:
        c = GREEN if val <= good else (YELLOW if val <= warn else RED)
    return f"{ansi(c)}{val:>{6}{fmt}}{unit}{ansi(RESET)}"


def sparkline(values, max_val=None):
    """Render a sparkline from numeric values. None is rendered as a gap/failure."""
    if not values:
        return ""
    nums = [v for v in values if v is not None]
    if not nums:
        return ansi(GRAY) + "?" * len(values) + ansi(RESET)
    lo = min(nums)
    hi = max_val or max(nums)
    rng = hi - lo if hi > lo else 1
    chars = []
    for v in values:
        if v is None:
            chars.append(f"{ansi(RED)}x{ansi(RESET)}")
        else:
            idx = int((v - lo) / rng * (len(SPARKLINE_CHARS) - 1))
            idx = max(0, min(idx, len(SPARKLINE_CHARS) - 1))
            chars.append(SPARKLINE_CHARS[idx])
    return "".join(chars)


def percentile(values, pct):
    nums = sorted(v for v in values if v is not None)
    if not nums:
        return None
    if len(nums) == 1:
        return nums[0]
    rank = (len(nums) - 1) * pct / 100
    lo = int(rank)
    hi = min(lo + 1, len(nums) - 1)
    frac = rank - lo
    return nums[lo] * (1 - frac) + nums[hi] * frac


def fmt_num(val, digits=1):
    return "" if val is None else f"{val:.{digits}f}"


def run_parallel(tasks, timeout=20):
    """Run a dict of {name: callable} on daemon threads, in parallel.

    Returns {name: result_or_None}, preserving insertion order. Any task that
    raises or hasn't finished within `timeout` resolves to None.
    """
    results = {name: None for name in tasks}

    def _worker(name, fn):
        try:
            results[name] = fn()
        except Exception:
            pass

    threads = []
    for name, fn in tasks.items():
        t = threading.Thread(target=_worker, args=(name, fn), daemon=True)
        t.start()
        threads.append(t)
    deadline = time.monotonic() + timeout
    for t in threads:
        t.join(timeout=max(0, deadline - time.monotonic()))
    return results


def ping_host(host, count=3, timeout_ms=3000):
    """Ping a host. Returns a dict with latency/loss/error."""
    try:
        proc_timeout = (timeout_ms / 1000) * count + 5
        r = subprocess.run(
            ["ping", "-c", str(count), "-W", str(timeout_ms), "-q", host],
            capture_output=True,
            text=True,
            timeout=proc_timeout,
        )
        output = r.stdout + r.stderr
        loss_match = re.search(r"([\d.]+)% packet loss", output)
        loss = float(loss_match.group(1)) if loss_match else 100.0
        rtt_match = re.search(
            r"(?:round-trip|rtt) min/avg/max/(?:stddev|mdev) = "
            r"([\d.]+)/([\d.]+)/([\d.]+)/([\d.]+)",
            output,
        )
        latency = float(rtt_match.group(2)) if rtt_match and loss < 100 else None
        return {"target": host, "latency_ms": latency, "loss_pct": loss, "error": None}
    except subprocess.TimeoutExpired:
        return {"target": host, "latency_ms": None, "loss_pct": 100.0, "error": "timeout"}
    except Exception as exc:
        return {"target": host, "latency_ms": None, "loss_pct": 100.0, "error": type(exc).__name__}


def get_gateway():
    """Get default gateway IP."""
    try:
        r = subprocess.run(
            ["route", "-n", "get", "default"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        for line in r.stdout.splitlines():
            if "gateway:" in line:
                return line.split("gateway:", 1)[1].strip()
    except Exception:
        pass
    return None


def ping_gateway(gateway):
    """Check gateway reachability. Tries ICMP first, then TCP connect."""
    if not gateway:
        return {"latency_ms": None, "loss_pct": 100.0, "method": "none"}
    icmp = ping_host(gateway, count=1, timeout_ms=2000)
    if icmp["loss_pct"] < 100:
        return {"latency_ms": icmp["latency_ms"], "loss_pct": icmp["loss_pct"], "method": "icmp"}
    for port in (80, 443, 53):
        try:
            start = time.monotonic()
            with socket.create_connection((gateway, port), timeout=2):
                elapsed = (time.monotonic() - start) * 1000
            return {"latency_ms": elapsed, "loss_pct": 0.0, "method": f"tcp/{port}"}
        except Exception:
            continue
    return {"latency_ms": None, "loss_pct": 100.0, "method": "failed"}


def dns_resolve(domain, timeout=5):
    """Time DNS resolution in a bounded worker thread."""
    result = {"ms": None, "ip": None, "error": None}

    def _resolve():
        start = time.monotonic()
        try:
            result["ip"] = socket.gethostbyname(domain)
            result["ms"] = (time.monotonic() - start) * 1000
        except Exception as exc:
            result["error"] = type(exc).__name__

    t = threading.Thread(target=_resolve, daemon=True)
    t.start()
    t.join(timeout)
    if t.is_alive():
        result["error"] = "timeout"
    return result


def check_captive_portal():
    """Return portal status plus status code/final URL/error details."""
    result = {
        "detected": None,
        "status": None,
        "final_url": None,
        "error": None,
        "body_sample": "",
    }
    try:
        req = urllib.request.Request(CAPTIVE_PORTAL_URL, headers={"User-Agent": f"netcheck/{__version__}"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = resp.read(256).decode("utf-8", errors="replace")
            result["status"] = getattr(resp, "status", None)
            result["final_url"] = resp.geturl()
            result["body_sample"] = data[:80].replace("\n", "\\n")
            result["detected"] = data != CAPTIVE_PORTAL_EXPECTED or resp.geturl() != CAPTIVE_PORTAL_URL
    except urllib.error.HTTPError as exc:
        result.update({"detected": True, "status": exc.code, "final_url": exc.geturl(), "error": "HTTPError"})
    except Exception as exc:
        result["error"] = type(exc).__name__
    return result


def check_throughput():
    """Download a small file and measure speed in KB/s."""
    errors = []
    for url in THROUGHPUT_URLS:
        try:
            start = time.monotonic()
            req = urllib.request.Request(url, headers={"User-Agent": f"netcheck/{__version__}"})
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = resp.read()
            elapsed = time.monotonic() - start
            size_kb = len(data) / 1024
            return {
                "kb_per_sec": size_kb / elapsed if elapsed > 0 else 0,
                "size_kb": size_kb,
                "url": url,
                "error": None,
            }
        except Exception as exc:
            errors.append(f"{url}: {type(exc).__name__}")
    return {"kb_per_sec": None, "size_kb": None, "url": None, "error": "; ".join(errors)}


CURL_FORMAT = (
    "%{time_namelookup}\t%{time_connect}\t%{time_appconnect}\t"
    "%{time_starttransfer}\t%{time_total}\t%{http_code}\t"
    "%{size_download}\t%{url_effective}\t%{errormsg}"
)


def probe_site(url, timeout=10):
    """Probe a URL with curl and return timing/status details."""
    try:
        r = subprocess.run(
            [
                "curl",
                "-sS",
                "-o",
                "/dev/null",
                "-w",
                CURL_FORMAT,
                "-L",
                "--max-time",
                str(timeout),
                url,
            ],
            capture_output=True,
            text=True,
            timeout=timeout + 5,
        )
        fields = r.stdout.rstrip("\n").split("\t", 8)
        if len(fields) != 9:
            return {"ok": False, "code": 0, "error": "bad curl output"}
        dns_s, tcp_s, tls_s, ttfb_s, total_s, code_s, size_s, final_url, err = fields
        dns = float(dns_s)
        tcp = float(tcp_s)
        tls = float(tls_s)
        ttfb = float(ttfb_s)
        total = float(total_s)
        code = int(code_s)
        size = int(size_s)
        ok = 200 <= code < 400
        err = err or None
        if code == 0 and not err:
            err = r.stderr.strip() or "curl failed"
        return {
            "ok": ok,
            "dns": dns * 1000,
            "tcp": max(0, (tcp - dns) * 1000),
            "tls": max(0, (tls - tcp) * 1000) if tls > 0 else 0,
            "ttfb": max(0, (ttfb - (tls if tls > 0 else tcp)) * 1000),
            "total": total * 1000,
            "code": code,
            "size_kb": size / 1024,
            "final_url": final_url,
            "error": err,
        }
    except subprocess.TimeoutExpired:
        return {"ok": False, "code": 0, "error": "timeout"}
    except Exception as exc:
        return {"ok": False, "code": 0, "error": type(exc).__name__}


def run_site_probes(probe_sites):
    """Probe all configured sites in parallel."""
    def _task(name, url):
        return lambda: {"name": name, "url": url, "result": probe_site(url)}

    tasks = {f"probe_{i}": _task(name, url) for i, (name, url) in enumerate(probe_sites)}
    raw = run_parallel(tasks, timeout=15)
    return [raw[k] for k in tasks if raw[k] is not None]


AIRPORT_PATH = "/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport"


class WifiInfoPoller:
    """Polls WiFi info in a background thread."""

    def __init__(self, interval=10, wait_first=False, wait_timeout=15):
        self.info = {}
        self.interval = interval
        self._lock = threading.Lock()
        self._has_airport = os.path.exists(AIRPORT_PATH)
        self._first_poll = threading.Event()
        self._thread = threading.Thread(target=self._poll, daemon=True)
        self._thread.start()
        if wait_first:
            self._first_poll.wait(timeout=wait_timeout)

    def _poll_airport(self):
        r = subprocess.run([AIRPORT_PATH, "-I"], capture_output=True, text=True, timeout=5)
        info = {}
        key_map = {
            "SSID": "ssid",
            "BSSID": "bssid",
            "agrCtlRSSI": "rssi",
            "agrCtlNoise": "noise",
            "lastTxRate": "tx_rate",
            "maxRate": "max_rate",
            "channel": "channel",
            "op mode": "op_mode",
            "MCS": "mcs",
        }
        for line in r.stdout.splitlines():
            if ":" not in line:
                continue
            raw_key, raw_val = line.strip().split(":", 1)
            key = key_map.get(raw_key.strip())
            if not key:
                continue
            val = raw_val.strip()
            if key in {"rssi", "noise", "tx_rate", "max_rate", "mcs"}:
                try:
                    val = int(val)
                except ValueError:
                    pass
            info[key] = val
        return info

    def _poll_system_profiler(self):
        r = subprocess.run(
            ["system_profiler", "SPAirPortDataType", "-detailLevel", "basic"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        info = {}
        in_current = False
        for line in r.stdout.splitlines():
            stripped = line.strip()
            if "Current Network Information:" in stripped:
                in_current = True
                continue
            if in_current and "PHY Mode:" in stripped:
                info["phy_mode"] = stripped.split(":", 1)[1].strip()
            elif in_current and "Channel:" in stripped:
                info["channel"] = stripped.split(":", 1)[1].strip()
            elif in_current and "Signal / Noise:" in stripped:
                m = re.search(r"(-?\d+)\s*dBm\s*/\s*(-?\d+)\s*dBm", stripped)
                if m:
                    info["rssi"] = int(m.group(1))
                    info["noise"] = int(m.group(2))
            elif in_current and "Transmit Rate:" in stripped:
                m = re.search(r"(\d+)", stripped)
                if m:
                    info["tx_rate"] = int(m.group(1))
            elif in_current and "BSSID:" in stripped:
                info["bssid"] = stripped.split(":", 1)[1].strip()
            elif in_current and "SSID:" in stripped:
                info["ssid"] = stripped.split(":", 1)[1].strip()
            elif in_current and "Security:" in stripped and "ssid" not in info:
                # Older system_profiler output puts the SSID on the preceding header line.
                pass
            elif in_current and stripped.endswith(":") and "ssid" not in info:
                info["ssid"] = stripped.rstrip(":")
        return info

    def _poll(self):
        while True:
            info = {}
            try:
                info = self._poll_airport() if self._has_airport else self._poll_system_profiler()
            except Exception:
                pass
            with self._lock:
                self.info = info
            self._first_poll.set()
            time.sleep(self.interval)

    def get(self):
        with self._lock:
            return dict(self.info)


def score_lower_better(val, good, warn):
    if val is None:
        return None
    if val <= good:
        return 100
    if val <= warn:
        return 100 - 50 * (val - good) / (warn - good)
    ceiling = warn * 2
    if val >= ceiling:
        return 0
    return 50 * (1 - (val - warn) / (ceiling - warn))


def score_higher_better(val, good, warn):
    if val is None:
        return None
    if val >= good:
        return 100
    if val >= warn:
        return 50 + 50 * (val - warn) / (good - warn)
    if warn == 0:
        return 0
    return max(0, 50 * val / warn)


HEALTH_WEIGHTS = {
    "loss": 0.25,
    "latency": 0.20,
    "probes": 0.15,
    "throughput": 0.15,
    "gateway": 0.10,
    "jitter": 0.10,
    "dns": 0.05,
}

BOTTLENECK_PRIORITY = ["loss", "latency", "gateway", "dns", "throughput", "probes", "jitter"]


def compute_health(latency, jitter, loss, dns_ms, throughput, gw_ok=True, probe_results=None, is_up=True):
    """Compute a 0-100 composite health score and component scores."""
    components = {
        "loss": score_lower_better(loss, LOSS_GOOD, LOSS_WARN),
        "latency": score_lower_better(latency, LATENCY_GOOD, LATENCY_WARN),
        "throughput": score_higher_better(throughput, THROUGHPUT_GOOD, THROUGHPUT_WARN),
        "gateway": 100 if gw_ok else 0,
        "jitter": score_lower_better(jitter, JITTER_GOOD, JITTER_WARN),
        "dns": score_lower_better(dns_ms, DNS_GOOD, DNS_WARN),
    }
    if not is_up:
        # Don't credit stale probe success once we're offline.
        components["probes"] = 0
    elif probe_results:
        successful = sum(1 for p in probe_results if p["result"].get("ok"))
        components["probes"] = (successful / len(probe_results)) * 100
    else:
        components["probes"] = None  # no probes yet — exclude from score

    measured = {k: v for k, v in components.items() if v is not None}
    if not measured:
        return 0, components
    total_weight = sum(HEALTH_WEIGHTS[k] for k in measured)
    health = sum(measured[k] * HEALTH_WEIGHTS[k] for k in measured) / total_weight
    return health, components


def bottleneck(components):
    labels = {
        "loss": "packet loss",
        "latency": "latency",
        "probes": "site access",
        "throughput": "throughput",
        "gateway": "gateway",
        "jitter": "jitter",
        "dns": "DNS",
    }
    measured = {k: v for k, v in components.items() if v is not None}
    if not measured:
        return "none"
    min_val = min(measured.values())
    if min_val >= 85:
        return "none"
    for key in BOTTLENECK_PRIORITY:
        if key in measured and measured[key] == min_val:
            return labels[key]
    return labels[next(iter(measured))]


def quality_label(score):
    if score >= 90:
        return f"{ansi(GREEN)}Video/calls OK{ansi(RESET)}"
    if score >= 70:
        return f"{ansi(GREEN)}Browsing OK{ansi(RESET)}"
    if score >= 50:
        return f"{ansi(YELLOW)}Chat/text only{ansi(RESET)}"
    if score >= 25:
        return f"{ansi(RED)}Barely usable{ansi(RESET)}"
    return f"{ansi(RED)}Unusable{ansi(RESET)}"


def health_bar(score, width=20):
    filled = int(score / 100 * width)
    c = GREEN if score >= 75 else (YELLOW if score >= 45 else RED)
    bar = ansi(c) + "█" * filled + ansi(GRAY) + "░" * (width - filled) + ansi(RESET)
    return f"{bar} {ansi(c)}{ansi(BOLD)}{score:.0f}{ansi(RESET)}{ansi(c)}/100{ansi(RESET)}"


def status_badge(up):
    if up:
        return f"{ansi(BG_GREEN)}{ansi(BOLD)} UP {ansi(RESET)}"
    return f"{ansi(BG_RED)}{ansi(BOLD)} DOWN {ansi(RESET)}"


