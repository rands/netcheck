def init_csv(path):
    if not path or os.path.exists(path):
        return
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(
            [
                "timestamp",
                "state",
                "health",
                "bottleneck",
                "latency_ms",
                "latency_p50_ms",
                "latency_p95_ms",
                "jitter_ms",
                "loss_pct",
                "dns_ms",
                "throughput_kBps",
                "gateway_ok",
                "gateway_ms",
                "gateway_method",
                "captive_portal",
                "portal_status",
                "portal_final_url",
                "ssid",
                "rssi",
                "noise",
                "tx_rate_mbps",
                "channel",
                "ping_targets",
            ]
        )


def log_csv(path, result):
    if not path:
        return
    wifi = result["wifi"]
    gateway = result["gateway"]
    portal = result["portal"]
    row = [
        result["timestamp"],
        "UP" if result["is_up"] else "DOWN",
        f"{result['health']:.0f}",
        result["bottleneck"],
        fmt_num(result["avg_latency_ms"]),
        fmt_num(result["latency_p50_ms"]),
        fmt_num(result["latency_p95_ms"]),
        fmt_num(result["jitter_ms"]),
        fmt_num(result["avg_loss_pct"]),
        fmt_num(result["dns"]["ms"]),
        fmt_num(result["throughput"]["kb_per_sec"]),
        "yes" if result["gateway_ok"] else "no",
        fmt_num(gateway["latency_ms"]),
        gateway["method"],
        "" if portal["detected"] is None else ("yes" if portal["detected"] else "no"),
        portal["status"] if portal["status"] is not None else "",
        portal["final_url"] or "",
        wifi.get("ssid", ""),
        wifi.get("rssi", ""),
        wifi.get("noise", ""),
        wifi.get("tx_rate", ""),
        wifi.get("channel", ""),
        json.dumps(result["ping_results"], separators=(",", ":")),
    ]
    with open(path, "a", newline="") as f:
        csv.writer(f).writerow(row)


def log_jsonl(path, result):
    if not path:
        return
    with open(path, "a") as f:
        f.write(json.dumps(result, separators=(",", ":"), sort_keys=True) + "\n")


def parse_probe_site(value):
    if "=" in value:
        name, url = value.split("=", 1)
        return name.strip(), url.strip()
    url = value.strip()
    name = re.sub(r"^https?://", "", url).split("/", 1)[0]
    return name, url


def parse_args():
    p = argparse.ArgumentParser(description="Terminal network health monitor.")
    p.add_argument("--version", action="version", version=f"netcheck {__version__}")
    p.add_argument("--interval", type=int, default=DEFAULT_INTERVAL, help="seconds between checks")
    p.add_argument("--log-file", default=DEFAULT_LOG_FILE, help="CSV log path; use '' to disable")
    p.add_argument("--json-log", default=None, help="optional JSONL log path")
    p.add_argument("--json", action="store_true", help="print one JSON result and exit")
    p.add_argument("--once", action="store_true", help="run one check and exit")
    p.add_argument("--quiet", action="store_true", help="suppress dashboard output")
    p.add_argument("--no-color", action="store_true", help="disable ANSI color")
    p.add_argument("--targets", default=",".join(DEFAULT_PING_TARGETS), help="comma-separated ping targets")
    p.add_argument(
        "--probe-site",
        action="append",
        default=[],
        metavar="NAME=URL",
        help="site probe; repeat to replace defaults",
    )
    p.add_argument("--no-probes", action="store_true", help="disable site probes")
    p.add_argument("--probe-interval", type=int, default=DEFAULT_PROBE_INTERVAL, help="checks between probes")
    p.add_argument("--threshold", type=int, default=DEFAULT_HEALTH_THRESHOLD, help="--once unhealthy exit threshold")
    p.add_argument("--notify", action="store_true", help="macOS notification on UP/DOWN transitions")
    p.add_argument("--sound", action="store_true", help="terminal bell on UP/DOWN transitions")
    args = p.parse_args()
    args.targets = [t.strip() for t in args.targets.split(",") if t.strip()]
    args.probe_sites = [] if args.no_probes else DEFAULT_PROBE_SITES
    if args.probe_site:
        args.probe_sites = [parse_probe_site(v) for v in args.probe_site]
    if args.json:
        args.once = True
    return args


def _collect_ping_metrics(args, state):
    """Ping every target plus the gateway in parallel; update history; return summary."""
    def _ping_task(host):
        return lambda: ping_host(host, count=3, timeout_ms=3000)

    tasks = {f"target_{i}": _ping_task(t) for i, t in enumerate(args.targets)}
    tasks["gateway"] = lambda: ping_gateway(state["gateway_ip"])
    raw = run_parallel(tasks, timeout=15)

    gateway = raw["gateway"] or {"latency_ms": None, "loss_pct": 100.0, "method": "none"}
    ping_results = [raw[f"target_{i}"] for i in range(len(args.targets)) if raw[f"target_{i}"]]
    latencies = [r["latency_ms"] for r in ping_results if r["latency_ms"] is not None]
    losses = [r["loss_pct"] for r in ping_results]
    avg_latency = statistics.mean(latencies) if latencies else None
    avg_loss = statistics.mean(losses) if losses else 100.0

    state["latency_hist"].append(avg_latency)
    state["loss_hist"].append(avg_loss)
    recent_latencies = [v for v in state["latency_hist"] if v is not None]
    jitter = statistics.stdev(recent_latencies) if len(recent_latencies) >= 2 else None
    state["jitter_hist"].append(jitter)

    return {
        "ping_results": ping_results,
        "gateway": gateway,
        "gateway_ok": gateway["loss_pct"] < 100,
        "avg_latency": avg_latency,
        "avg_loss": avg_loss,
        "jitter": jitter,
        "is_up": avg_latency is not None and avg_loss < 100,
    }


def _collect_service_metrics(args, state, is_up, force_probes):
    """Run DNS, captive-portal, throughput, and (sometimes) site probes in parallel.

    Returns (dns, portal, throughput). When the network is down, returns blanks.
    Probe results are stashed on `state["probe_results"]` since they're sampled
    less often than the other metrics.
    """
    dns = {"ms": None, "ip": None, "error": None}
    portal = {"detected": None, "status": None, "final_url": None, "error": None, "body_sample": ""}
    throughput = {"kb_per_sec": None, "size_kb": None, "url": None, "error": None}
    if not is_up:
        return dns, portal, throughput

    should_probe = bool(args.probe_sites) and (
        force_probes or state["iteration"] % max(1, args.probe_interval) == 0
    )
    tasks = {
        "dns": lambda: dns_resolve(DNS_TEST_DOMAIN),
        "portal": check_captive_portal,
        "throughput": check_throughput,
    }
    if should_probe:
        tasks["probes"] = lambda: run_site_probes(args.probe_sites)
    raw = run_parallel(tasks, timeout=20)

    if raw.get("probes") is not None:
        state["probe_results"] = raw["probes"]
    return raw["dns"] or dns, raw["portal"] or portal, raw["throughput"] or throughput


def _record_transition(args, state, now, is_up, health):
    """Update up/down counts; on state change, append to history and fire side effects."""
    if is_up:
        state["up_count"] += 1
    else:
        state["down_count"] += 1
    if state["last_state"] is None or is_up != state["last_state"]:
        transition = (now.strftime("%H:%M:%S"), "UP" if is_up else "DOWN")
        state["transitions"].append(transition)
        state["events"].append({"time": now, "state": transition[1]})
        if state["last_state"] is not None:
            if args.sound:
                sys.stdout.write("\a")
                sys.stdout.flush()
            if args.notify:
                notify_transition(transition[1], health)
    state["last_state"] = is_up


def collect_check(args, state, wifi_poller, force_probes=False):
    """Run one health-check cycle: ping → services → score → record → assemble result."""
    now = datetime.now()
    if state["iteration"] % 30 == 0 or not state["gateway_ip"]:
        state["gateway_ip"] = get_gateway()

    pings = _collect_ping_metrics(args, state)
    is_up = pings["is_up"]

    dns, portal, throughput = _collect_service_metrics(args, state, is_up, force_probes)
    state["dns_hist"].append(dns["ms"])
    state["throughput_hist"].append(throughput["kb_per_sec"])

    health, components = compute_health(
        pings["avg_latency"], pings["jitter"], pings["avg_loss"],
        dns["ms"], throughput["kb_per_sec"],
        pings["gateway_ok"], state["probe_results"], is_up,
    )
    state["health_hist"].append(health)
    _record_transition(args, state, now, is_up, health)

    result = {
        "timestamp": now.isoformat(),
        "is_up": is_up,
        "health": health,
        "components": components,
        "bottleneck": bottleneck(components),
        "avg_latency_ms": pings["avg_latency"],
        "latency_p50_ms": percentile(state["latency_hist"], 50),
        "latency_p95_ms": percentile(state["latency_hist"], 95),
        "jitter_ms": pings["jitter"],
        "avg_loss_pct": pings["avg_loss"],
        "dns": dns,
        "throughput": throughput,
        "gateway_ip": state["gateway_ip"],
        "gateway": pings["gateway"],
        "gateway_ok": pings["gateway_ok"],
        "portal": portal,
        "wifi": wifi_poller.get() if wifi_poller else {},
        "ping_results": pings["ping_results"],
        "probe_results": state["probe_results"],
        "uptime_pct": uptime_pct(state),
        "checks": state["up_count"] + state["down_count"],
    }
    state["check_log"].append({"time": now, "health": health, "is_up": is_up})
    state["last_result"] = result
    return result


def uptime_pct(state):
    total = state["up_count"] + state["down_count"]
    return (state["up_count"] / total * 100) if total else 0


def notify_transition(status, health):
    try:
        subprocess.run(
            [
                "osascript",
                "-e",
                f'display notification "Network {status}, health {health:.0f}/100" with title "netcheck"',
            ],
            capture_output=True,
            timeout=5,
        )
    except Exception:
        pass


