def plain_summary(result):
    state = "UP" if result["is_up"] else "DOWN"
    portal = portal_label(result["portal"], plain=True)
    return (
        f"{state} health={result['health']:.0f}/100 "
        f"lat={fmt_num(result['avg_latency_ms']) or '--'}ms "
        f"loss={fmt_num(result['avg_loss_pct'])}% "
        f"dns={fmt_num(result['dns']['ms']) or '--'}ms "
        f"throughput={fmt_num(result['throughput']['kb_per_sec']) or '--'}KB/s "
        f"bottleneck={result['bottleneck']} portal={portal}"
    )


def portal_label(portal, plain=False):
    detected = portal.get("detected")
    if detected is True:
        text = "captive"
        return text if plain else f"{ansi(RED)}{ansi(BOLD)}{text}{ansi(RESET)}"
    if detected is False:
        text = "clean"
        return text if plain else f"{ansi(GREEN)}{text}{ansi(RESET)}"
    text = "unknown"
    return text if plain else f"{ansi(YELLOW)}{text}{ansi(RESET)}"


def signal_label(rssi):
    """RSSI in dBm → (human label, color). Returns (None, DIM) if unknown."""
    if rssi is None:
        return None, DIM
    if rssi >= -50:
        return "Excellent", GREEN
    if rssi >= -65:
        return "Good", GREEN
    if rssi >= -75:
        return "Fair", YELLOW
    return "Weak", RED


def speed_label(tx_rate):
    """Tx link rate (Mbps int) → 'X Mbps' or 'X.Y Gbps'. None if unknown."""
    if not tx_rate:
        return None
    if tx_rate >= 1000:
        return f"{tx_rate / 1000:.1f} Gbps"
    return f"{tx_rate} Mbps"


def band_label(channel):
    """Channel field (e.g. '149 (5GHz, 80MHz)' or '149,80') → '2.4 GHz' / '5 GHz' / '6 GHz'."""
    if not channel:
        return None
    s = str(channel).lower()
    if "5ghz" in s or "5 ghz" in s:
        return "5 GHz"
    if "6ghz" in s or "6 ghz" in s:
        return "6 GHz"
    if "2ghz" in s or "2 ghz" in s or "2.4" in s:
        return "2.4 GHz"
    m = re.match(r"\s*(\d+)", s)
    if m:
        ch = int(m.group(1))
        if 1 <= ch <= 14:
            return "2.4 GHz"
        if 36 <= ch <= 177:
            return "5 GHz"
    return None


CURL_ERROR_TAGS = (
    (("could not resolve", "name resolution", "unknown host"), "DNS fail"),
    (("timed out", "timeout"), "timeout"),
    (("refused",), "refused"),
    (("ssl", "tls", "certificate", "handshake"), "TLS fail"),
    (("empty reply",), "no reply"),
    (("reset by peer", "connection reset"), "reset"),
    (("no route", "host is unreachable", "network is unreachable"), "no route"),
)


def short_probe_error(err):
    if not err:
        return "error"
    e = err.lower()
    for needles, tag in CURL_ERROR_TAGS:
        if any(n in e for n in needles):
            return tag
    return "error"


def stale_label(val, hist):
    """If `val` is missing, decide what to render in the value column."""
    if val is not None:
        return None
    return "timing out" if any(v is not None for v in hist) else "no data"


def diagnose(result):
    """One-line explanation when the metric grid doesn't tell the real story."""
    if result["portal"].get("detected") is True:
        return "Captive portal — sign in required"
    if not result["is_up"]:
        if result["gateway_ok"]:
            return "Gateway reachable, Internet unreachable — likely captive portal or carrier outage"
        return "Gateway unreachable — WiFi associated but no link to router"
    return None


def render_dashboard(args, state, result):
    move_home()
    size = term_size()
    w = size.columns
    lines = []
    elapsed_total = (datetime.now() - state["start_time"]).total_seconds()
    runtime = f"{int(elapsed_total // 60)}m {int(elapsed_total % 60)}s"
    wifi = result["wifi"]
    rssi = wifi.get("rssi")
    sig_text, sig_color = signal_label(rssi)
    speed = speed_label(wifi.get("tx_rate"))
    band = band_label(wifi.get("channel"))

    state_color = GREEN if result["is_up"] else RED
    state_text = "UP" if result["is_up"] else "DOWN"
    sep = f" {ansi(GRAY)}·{ansi(RESET)} "
    net_bits = [f"{ansi(BOLD)}{wifi.get('ssid') or 'unknown'}{ansi(RESET)}"]
    if band:
        net_bits.append(band)
    if sig_text:
        net_bits.append(f"{ansi(sig_color)}{sig_text}{ansi(RESET)}")
    if speed:
        net_bits.append(speed)
    header_left = (
        f"{ansi(BOLD)}{ansi(CYAN)}netcheck{ansi(RESET)}   "
        f"{ansi(state_color)}●{ansi(RESET)} "
        f"{ansi(BOLD)}{ansi(state_color)}{state_text}{ansi(RESET)}{sep}"
        + sep.join(net_bits)
    )
    header_right = f"{ansi(DIM)}{runtime}{ansi(RESET)}"
    left_w = len(strip_ansi(header_left))
    right_w = len(strip_ansi(header_right))
    pad = max(2, w - left_w - right_w - 1)
    lines.append(header_left + " " * pad + header_right)
    lines.append("")

    spark_w = min(30, max(10, w - 50))
    health_spark_w = max(20, w - 18)
    health_spark = sparkline(list(state["health_hist"])[-health_spark_w:], max_val=100)
    lines.append(
        f"  {'Health':<14} {health_bar(result['health'])}   {quality_label(result['health'])}"
    )
    lines.append(f"  {'':<14} {health_spark}")
    diag = diagnose(result)
    if diag:
        lines.append(f"  {'':<14} {ansi(YELLOW)}↳ {diag}{ansi(RESET)}")
    lines.append("")

    val_col_w = 11

    def metric_line(label, val, good, warn, unit, hist, max_v=None, inverse=False, fmt=".0f", missing=None, suffix=""):
        sl = sparkline(list(hist)[-spark_w:], max_val=max_v)
        if val is None and missing:
            color = GRAY if missing == "no data" else RED
            cell = f"{ansi(color)}{missing:>{val_col_w}}{ansi(RESET)}"
        else:
            cv = color_val(val, good, warn, unit, inverse=inverse, fmt=fmt)
            pad = max(0, val_col_w - (6 + len(unit)))
            cell = f"{cv}{' ' * pad}"
        line = f"  {label:<14} {cell}  {sl}"
        if suffix:
            line += f"   {suffix}"
        return line

    latency_v = result["avg_latency_ms"]
    jitter_v = result["jitter_ms"]
    dns_v = result["dns"]["ms"]
    throughput_v = result["throughput"]["kb_per_sec"]
    p50 = fmt_num(result["latency_p50_ms"], 0) or "--"
    p95 = fmt_num(result["latency_p95_ms"], 0) or "--"
    lat_suffix = f"{ansi(DIM)}p50 {p50}{sep}p95 {p95}{ansi(RESET)}"
    lines.append(metric_line(
        "Latency", latency_v, LATENCY_GOOD, LATENCY_WARN, " ms", state["latency_hist"], 1000,
        missing=stale_label(latency_v, state["latency_hist"]),
        suffix=lat_suffix,
    ))
    lines.append(metric_line(
        "Jitter", jitter_v, JITTER_GOOD, JITTER_WARN, " ms", state["jitter_hist"], 200,
        missing=stale_label(jitter_v, state["jitter_hist"]),
    ))
    lines.append(metric_line("Loss", result["avg_loss_pct"], LOSS_GOOD, LOSS_WARN, " %", state["loss_hist"], 100))
    lines.append(metric_line(
        "DNS", dns_v, DNS_GOOD, DNS_WARN, " ms", state["dns_hist"], 1000,
        missing=stale_label(dns_v, state["dns_hist"]),
    ))
    lines.append(
        metric_line(
            "Throughput",
            throughput_v,
            THROUGHPUT_GOOD,
            THROUGHPUT_WARN,
            " KB/s",
            state["throughput_hist"],
            200,
            inverse=True,
            fmt=".1f",
            missing=stale_label(throughput_v, state["throughput_hist"]),
        )
    )
    lines.append("")

    upct = result["uptime_pct"]
    up_color = GREEN if upct >= 95 else (YELLOW if upct >= 80 else RED)
    uptime_str = f"{ansi(up_color)}{upct:.1f}%{ansi(RESET)} uptime"
    checks_str = f"{ansi(DIM)}{state['up_count']}/{result['checks']} checks{ansi(RESET)}"
    portal_str = f"portal {portal_label(result['portal'])}"
    lines.append(f"  {'Session':<14} " + sep.join([uptime_str, checks_str, portal_str]))

    gateway = result["gateway"]
    if result["gateway_ok"]:
        gw_color = GREEN
        gw_latency_str = f"{gateway['latency_ms']:.0f} ms via {gateway['method']}" if gateway["latency_ms"] is not None else gateway["method"]
    elif result["is_up"]:
        gw_color = YELLOW
        gw_latency_str = "filtered"
    else:
        gw_color = RED
        gw_latency_str = "unreachable"
    gw_ip = result["gateway_ip"] or "?"
    lines.append(
        f"  {'Gateway':<14} {ansi(gw_color)}●{ansi(RESET)} "
        f"{ansi(gw_color)}{gw_latency_str}{ansi(RESET)}{sep}{ansi(DIM)}{gw_ip}{ansi(RESET)}"
    )
    lines.append("")

    if result["probe_results"]:
        iters_until_probe = (max(1, args.probe_interval) - (state["iteration"] % max(1, args.probe_interval))) % max(1, args.probe_interval)
        probe_eta = "just ran" if iters_until_probe == 0 else f"next in {iters_until_probe * args.interval}s"
        lines.append(f"  {ansi(BOLD)}Site Probes{ansi(RESET)}  {ansi(DIM)}({probe_eta}){ansi(RESET)}")
        lines.append(f"  {ansi(DIM)}{'':>12} {'Code':>4} {'DNS':>6} {'TTFB':>6} {'Total':>7}{ansi(RESET)}")
        def _fmt_t(v):
            return f"{v:>5.0f}" if v is not None else f"{'--':>5}"

        for probe in result["probe_results"]:
            name = probe["name"]
            t = probe["result"]
            if t.get("ok"):
                dns_c = timing_color(t["dns"], 50, 200)
                ttfb_c = timing_color(t["ttfb"], 300, 800)
                total_c = timing_color(t["total"], 1000, 3000)
                lines.append(f"  {name:>12} {t['code']:>4} {dns_c}  {ttfb_c}  {total_c} ms")
            else:
                code = t.get("code") or 0
                code_str = str(code) if code else "--"
                tag = f"HTTP {code}" if code >= 400 else short_probe_error(t.get("error"))
                lines.append(
                    f"  {ansi(RED)}{name:>12} {code_str:>4} "
                    f"{_fmt_t(t.get('dns'))}  {_fmt_t(t.get('ttfb'))}  {_fmt_t(t.get('total'))} ms"
                    f"  {tag}{ansi(RESET)}"
                )
        lines.append("")

    if state["events"]:
        lines.extend(render_transitions(state))
        lines.append("")

    log_parts = []
    if args.log_file:
        log_parts.append(args.log_file)
    if args.json_log:
        log_parts.append(args.json_log)
    log_str = (" " + chr(0xB7) + " ").join(log_parts) if log_parts else "no log"
    footer_left = f"  {ansi(DIM)}{'─' * 8}  {log_str}  ·  ⌃C to quit{ansi(RESET)}"
    countdown_row = len(lines) + 1
    bar_visible = 10 + 1 + 4  # 10 cells + space + "Ns " worst-case
    left_w = len(strip_ansi(footer_left))
    gap = max(2, w - left_w - bar_visible - 1)
    countdown_prefix = footer_left + " " * gap
    lines.append(
        f"{countdown_prefix}{ansi(CYAN)}{'█' * 10}{ansi(RESET)} {ansi(DIM)}{args.interval}s{ansi(RESET)}"
    )

    clear_eol = "\033[K"
    while len(lines) < size.lines - 1:
        lines.append("")
    output = "\n".join(line + clear_eol for line in lines[: size.lines - 1])
    print(output, flush=True)
    return countdown_row, countdown_prefix


def render_transitions(state, max_segments=7):
    """Render the Transitions block: current-state pill + duration ribbon.

    Top line   : ● UP for 24s            3 outages · longest 28s
    Ribbon line: ↑16m23s ▸ ↓16s ▸ ↑1m22s ▸ ↓14s ▸ now
    """
    events = list(state["events"])
    now_dt = datetime.now()

    is_up = bool(state["last_state"])
    pill_color = GREEN if is_up else RED
    label = "UP" if is_up else "DOWN"
    elapsed = (now_dt - events[-1]["time"]).total_seconds()
    pill = (
        f"{ansi(pill_color)}●{ansi(RESET)} "
        f"{ansi(BOLD)}{ansi(pill_color)}{label}{ansi(RESET)} "
        f"{ansi(DIM)}for{ansi(RESET)} {format_duration(elapsed)}"
    )

    outages = sum(1 for e in events if e["state"] == "DOWN")
    summary_bits = []
    if outages:
        summary_bits.append(f"{outages} outage{'s' if outages != 1 else ''}")
        longest = longest_outage_seconds(state)
        if longest:
            summary_bits.append(f"longest {format_duration(longest)}")
    summary = (
        f"{ansi(DIM)}{(' ' + chr(0xB7) + ' ').join(summary_bits)}{ansi(RESET)}"
        if summary_bits else ""
    )

    header = f"  {'Transitions':<14} {pill}"
    if summary:
        header += f"    {summary}"

    # Skip the ribbon row when there's only an in-progress segment to show.
    if len(events) < 2:
        return [header]

    segments = []
    for i, ev in enumerate(events[:-1]):
        dur = (events[i + 1]["time"] - ev["time"]).total_seconds()
        arrow = "↑" if ev["state"] == "UP" else "↓"
        color = GREEN if ev["state"] == "UP" else RED
        segments.append(f"{ansi(color)}{arrow}{format_duration(dur)}{ansi(RESET)}")
    segments.append(f"{ansi(DIM)}now{ansi(RESET)}")

    truncated = len(segments) > max_segments
    if truncated:
        segments = segments[-max_segments:]

    sep = f" {ansi(GRAY)}▸{ansi(RESET)} "
    ribbon = sep.join(segments)
    if truncated:
        ribbon = f"{ansi(DIM)}…{ansi(RESET)}{sep}{ribbon}"

    return [header, f"  {'':<14} {ribbon}"]


def timing_color(v, good, bad):
    if v <= good:
        c = GREEN
    elif v <= bad:
        c = YELLOW
    else:
        c = RED
    return f"{ansi(c)}{v:>5.0f}{ansi(RESET)}"


def render_countdown(row, interval, prefix=""):
    next_check = time.monotonic() + interval
    while True:
        remaining = next_check - time.monotonic()
        if remaining <= 0:
            break
        filled = round(remaining / interval * 10)
        bar = f"{ansi(CYAN)}{'█' * filled}{ansi(GRAY)}{'░' * (10 - filled)}{ansi(RESET)}"
        line = f"{prefix}{bar} {ansi(DIM)}{int(remaining)}s{ansi(RESET)}\033[K"
        sys.stdout.write(f"\033[{row};1H{line}")
        sys.stdout.flush()
        time.sleep(1)


def session_summary(state):
    total = state["up_count"] + state["down_count"]
    if total == 0:
        return "No checks completed."
    latencies = [v for v in state["latency_hist"] if v is not None]
    losses = [v for v in state["loss_hist"] if v is not None]
    health = [v for v in state["health_hist"] if v is not None]
    outages = sum(1 for _, s in state["transitions"] if s == "DOWN")
    worst_health = min(health) if health else None
    longest = longest_outage_seconds(state)
    worst_window = worst_window_health(state, seconds=300)
    return (
        f"{total} checks, uptime {uptime_pct(state):.1f}%, outages {outages}, "
        f"longest outage {format_duration(longest)}, "
        f"median latency {fmt_num(percentile(latencies, 50), 0) or '--'} ms, "
        f"p95 latency {fmt_num(percentile(latencies, 95), 0) or '--'} ms, "
        f"avg loss {fmt_num(statistics.mean(losses) if losses else None)}%, "
        f"worst health {fmt_num(worst_health, 0) or '--'}/100, "
        f"worst 5m avg {fmt_num(worst_window, 0) or '--'}/100"
    )


def longest_outage_seconds(state):
    events = state["events"]
    if not events:
        return 0
    longest = 0
    down_since = None
    end_time = datetime.now()
    for event in events:
        if event["state"] == "DOWN" and down_since is None:
            down_since = event["time"]
        elif event["state"] == "UP" and down_since is not None:
            longest = max(longest, (event["time"] - down_since).total_seconds())
            down_since = None
    if down_since is not None:
        longest = max(longest, (end_time - down_since).total_seconds())
    return longest


def worst_window_health(state, seconds=300):
    """Worst average health over any rolling window of `seconds`. O(n) sliding window."""
    checks = list(state["check_log"])
    if not checks:
        return None
    worst = None
    j = 0
    window_sum = 0.0
    window_count = 0
    for i, start in enumerate(checks):
        while j < len(checks) and (checks[j]["time"] - start["time"]).total_seconds() <= seconds:
            window_sum += checks[j]["health"]
            window_count += 1
            j += 1
        if window_count > 0:
            avg = window_sum / window_count
            worst = avg if worst is None else min(worst, avg)
        window_sum -= start["health"]
        window_count -= 1
    return worst


def format_duration(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    minutes, sec = divmod(seconds, 60)
    if minutes < 60:
        return f"{minutes}m {sec}s"
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h {minutes}m"


def main():
    global USE_COLOR
    args = parse_args()
    USE_COLOR = not args.no_color and sys.stdout.isatty()
    state = new_state()
    init_csv(args.log_file)
    wifi_poller = WifiInfoPoller(interval=30, wait_first=args.once)

    if not args.quiet and not args.once:
        clear_screen()

    while True:
        try:
            result = collect_check(args, state, wifi_poller, force_probes=args.once)
            log_csv(args.log_file, result)
            log_jsonl(args.json_log, result)

            if args.json:
                print(json.dumps(result, indent=None if args.quiet else 2, sort_keys=True))
            elif args.once or args.quiet:
                if not args.quiet:
                    print(plain_summary(result))
            else:
                countdown_row, countdown_prefix = render_dashboard(args, state, result)

            state["iteration"] += 1

            if args.once:
                sys.exit(0 if result["health"] >= args.threshold and result["is_up"] else 1)
            if not args.quiet:
                render_countdown(countdown_row, args.interval, countdown_prefix)
            else:
                time.sleep(args.interval)

        except KeyboardInterrupt:
            if not args.quiet:
                clear_screen()
            print(f"\n{ansi(BOLD)}netcheck{ansi(RESET)} stopped. {session_summary(state)}")
            if args.log_file:
                print(f"CSV log: {args.log_file}")
            if args.json_log:
                print(f"JSONL log: {args.json_log}")
            print("")
            sys.exit(0)


if __name__ == "__main__":
    main()
